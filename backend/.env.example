PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/rag_chatbot
RAG_SERVICE_URL=http://localhost:8000
RAG_SERVICE_API_KEY=replace_with_a_long_random_shared_secret
RAG_REQUEST_TIMEOUT_MS=900000
RAG_INGEST_MAX_ATTEMPTS=4
RAG_INGEST_RETRY_BASE_MS=1000
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional: set these to the current prices for OPENAI_CHAT_MODEL to display estimated cost.
# Leave at 0 to hide cost estimates rather than show inaccurate pricing.
OPENAI_INPUT_COST_PER_1M=0
OPENAI_OUTPUT_COST_PER_1M=0
# Pentarix prepaid-credit charging rates. Defaults make one input token cost
# one credit and one output token cost four credits. Change only for new pricing.
PENTARIX_INPUT_CREDITS_PER_1M=1000000
PENTARIX_OUTPUT_CREDITS_PER_1M=4000000
PENTARIX_REALTIME_INPUT_CREDITS_PER_1M=1000000
PENTARIX_REALTIME_OUTPUT_CREDITS_PER_1M=4000000
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
UPLOAD_DIR=./uploads
JWT_SECRET=change-this-dev-secret
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=admin123
GRAPH_API_VERSION=v26.0
META_APP_ID=replace_with_your_pentarix_meta_app_id
META_APP_SECRET=replace_with_your_pentarix_meta_app_secret
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=replace_with_your_embedded_signup_configuration_id
MESSENGER_LOGIN_CONFIG_ID=replace_with_your_facebook_login_for_business_configuration_id
WHATSAPP_VERIFY_TOKEN=replace_with_your_own_verify_token
WHATSAPP_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret_at_least_32_chars
MESSENGER_VERIFY_TOKEN=replace_with_your_own_verify_token
MESSENGER_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret_at_least_32_chars
# META_APP_SECRET validates both WhatsApp and Messenger webhook signatures.
# WHATSAPP_APP_SECRET and MESSENGER_APP_SECRET are supported only as legacy fallbacks.
SMS_TOKEN_ENCRYPTION_KEY=use_a_long_random_secret_here
PUBLIC_BACKEND_URL=http://localhost:3000
TWILIO_VALIDATE_WEBHOOK_SIGNATURE=true
